# Environment Configuration for Tiffin Finder Platform

# Database: SQLite for zero-config local development, or PostgreSQL URL
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET="tiffin-finder-secure-jwt-secret-key-min-32-chars-long"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Tiffin Finder"
NEXT_PUBLIC_DEFAULT_CITY="Pune"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Feature Flags & Integrations (Abstractions)
# MAPS_API_KEY=""
# NOTIFICATION_PROVIDER="in_app" # in_app | email | whatsapp
